#!/usr/bin/env bash

set -euxo pipefail

if [[ $# -gt 0 ]]; then
  echo "
  Usage: ${0##*/}
  Builds and installs timber onto your system into ~/.local, making it available as ~/.local/bin/timber.

  Before running this you should ensure you have all the build dependencies installed with `./script/linux`.
  "
  exit 1
fi
export TIMBER_CHANNEL=$(<crates/zed/RELEASE_CHANNEL)
export ZED_UPDATE_EXPLANATION="Install a newer Timber release from Coding-M8s/timber-ide to update."
script/bundle-linux --desktop-only --skip-sentry

arch="$(uname -m)"
commit=$(git rev-parse HEAD | cut -c 1-7)
archive="timber-linux-${arch}.tar.gz"
export TIMBER_BUNDLE_PATH="${CARGO_TARGET_DIR:-target}/release/${archive}"
script/install.sh
